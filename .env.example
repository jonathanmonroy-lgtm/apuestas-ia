# Copia este archivo a .env y rellena los valores. NUNCA commitees .env.

ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true

# SQLite para prototipar (por defecto). Para Postgres (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://apuestas:apuestas_dev_only@127.0.0.1:5432/apuestas
DATABASE_URL=sqlite:///./apuestas.db

# --- Proveedores de datos (cuentas creadas manualmente) ---
# football_data activo: el plan gratuito de API-Football no cubre 2026-27 (verificado 2026-10-14)
FIXTURES_PROVIDER=football_data
ODDS_PROVIDER=the_odds_api
NEWS_PROVIDER=newsapi

API_FOOTBALL_KEY=
FOOTBALL_DATA_KEY=
ODDS_API_KEY=
NEWSAPI_KEY=

# --- Worker (app.worker) ---
FIXTURES_SYNC_HOUR_UTC=6
FIXTURES_SYNC_MINUTE=15
ODDS_MONTHLY_BUDGET=450
ODDS_SYNC_INTERVAL_HOURS=3
ODDS_CREDIT_RESERVE=50
NEWSAPI_DAILY_BUDGET=50
NEWS_SYNC_INTERVAL_HOURS=1
NEWS_STALE_AFTER_HOURS=2
RAW_PAYLOAD_RETENTION_DAYS=30

# --- Cumplimiento: MODO SOLO INTERNO hasta decidir jurisdicción ---
INTERNAL_MODE=true
ODDS_REGIONS=eu
ODDS_STALE_AFTER_HOURS=4

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
