# Copia este archivo a .env y rellena los valores. NUNCA commitees .env.

ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true

# SQLite para prototipar (por defecto). Para Postgres (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://apuestas:apuestas_dev_only@127.0.0.1:5432/apuestas
DATABASE_URL=sqlite:///./apuestas.db

# --- Proveedores de datos (cuentas creadas manualmente) ---
FIXTURES_PROVIDER=api_football
ODDS_PROVIDER=the_odds_api
NEWS_PROVIDER=newsapi

API_FOOTBALL_KEY=
ODDS_API_KEY=
NEWSAPI_KEY=

# --- Cumplimiento: MODO SOLO INTERNO hasta decidir jurisdicción ---
INTERNAL_MODE=true
ODDS_REGIONS=eu
ODDS_STALE_AFTER_HOURS=4

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
